# --- Application ---
APP_NAME=SentinelMail AI
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Security ---
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_dev_only_do_not_use_in_prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database ---
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_dev_password
POSTGRES_DB=sentinelmail
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel_dev_password@db:5432/sentinelmail

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Evidence storage ---
EVIDENCE_STORAGE_BACKEND=local
EVIDENCE_STORAGE_PATH=/data/evidence
MAX_UPLOAD_SIZE_MB=25

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- Threat intel (optional external providers; leave blank to run in offline/demo mode) ---
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
IPINFO_TOKEN=
